# Where this console points. Copy to `.env.local` and adjust if your backend
# isn't on the default port. Omit the trailing slash — the client strips it anyway.
VITE_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Nothing else belongs in this file.
#
# Vite inlines every VITE_* variable into the JavaScript it ships, in plain
# text. Anyone who opens the console's bundle can read them. So DATABASE_URL,
# BETTER_AUTH_SECRET, the Resend API key and the M-Pesa credentials stay in
# propertyHubBackend/.env and are never referenced here — not even prefixed
# differently, not even "just for local".
#
# The admin account is provisioned server-side too:
#   cd ../propertyHubBackend && node scripts/create-admin.mjs \
#     --email you@example.com --password '...' --name 'Your Name'
# There is no sign-up in this app; `POST /sign-up/email` downgrades any
# self-assigned ADMIN to TENANT, so an admin can only be created by that script
# or promoted by an existing admin.
# ---------------------------------------------------------------------------
